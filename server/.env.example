# Server Configuration
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://localhost:27017/obi-uto

# Authentication
JWT_SECRET=your_jwt_secret_here_min_32_chars

# Paystack (test mode for development)
PAYSTACK_SECRET_KEY=sk_test_xxxxx

# CORS Allowed Origins (comma-separated for production)
# Leave empty for development (allows localhost and LAN)
ALLOWED_ORIGINS=

# Media Streaming
# Public base URL used to build live playback URLs.
# REQUIRED in production; development falls back to a local address.
MEDIA_BASE_URL=http://localhost:8000
# Path to ffmpeg (Linux example: /usr/bin/ffmpeg)
FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe

# Cloudinary (for media uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_KEY=your_api_key
CLOUDINARY_SECRET=your_api_secret

# PHASE 26 — External media (Internet Archive, keyless, server-side only).
# No secrets required. Mobile must never call archive.org directly.
EXTERNAL_MEDIA_ENABLED=true
EXTERNAL_MEDIA_TIMEOUT_MS=8000
EXTERNAL_MEDIA_CACHE_TTL_MS=600000
EXTERNAL_MEDIA_LIMIT=8