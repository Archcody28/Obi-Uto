# Server Configuration
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://localhost:27017/obi-uto

# Authentication
JWT_SECRET=your_jwt_secret_here_min_32_chars

# Paystack (test mode for development)
PAYSTACK_SECRET_KEY=sk_test_xxxxx

# CORS Allowed Origins (comma-separated for production)
# Leave empty for development (allows localhost and LAN)
ALLOWED_ORIGINS=

# Media Streaming
# Public base URL used to build live playback URLs.
# REQUIRED in production; development falls back to a local address.
# On Railway use the service's public HTTPS domain with NO port, e.g.
# https://your-service.up.railway.app — HLS is then served by the main API
# at <MEDIA_BASE_URL>/live/<streamKey>/index.m3u8.
MEDIA_BASE_URL=http://localhost:8000
# Path to ffmpeg (Linux example: /usr/bin/ffmpeg)
FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe

# ---------------------------------------------------------------------------
# Phase 33 — Railway deployment variables. NAMES ONLY below; set the real
# values in the Railway service environment. Never commit real values, keys,
# or tokens (.env is git-ignored and excluded by .dockerignore).
# ---------------------------------------------------------------------------
# Railway injects PORT itself; the Express API already binds to it.
#PORT=8080
#NODE_ENV=production
# Public HTTPS origin of this service (no port, no trailing slash).
#MEDIA_BASE_URL=https://your-service.up.railway.app
# Public RTMP ingest URL from the Railway TCP proxy (host:port that the TCP
# proxy forwards to the container's RTMP_PORT). REQUIRED in production —
# without it creators cannot publish (server reports an empty RTMP URL).
#RTMP_PUBLIC_URL=rtmp://your-tcp-proxy-host:your-tcp-proxy-port
# Alternative to RTMP_PUBLIC_URL: explicit RTMP host (+ RTMP_PORT).
#PUBLIC_HOST=your-tcp-proxy-host
#RTMP_PORT=1935
# Internal media/NMS HTTP port (not exposed publicly; dev/LAN HLS static
# server runs on MEDIA_PORT+1). Only change if it would collide with PORT.
#MEDIA_PORT=8000
# Interface RTMP + NMS bind to inside the container (keep 0.0.0.0 so the
# TCP proxy can reach RTMP).
#MEDIA_BIND=0.0.0.0
# Set to 0 on Railway to skip the extra dev-style HLS static listener;
# the main Express API serves /live itself.
#HLS_STATIC=0
# Comma-separated browser origins allowed by CORS (e.g. your Vercel domain).
#ALLOWED_ORIGINS=https://your-app.vercel.app


# Cloudinary (for media uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_KEY=your_api_key
CLOUDINARY_SECRET=your_api_secret

# PHASE 26 — External media (Internet Archive, keyless, server-side only).
# No secrets required. Mobile must never call archive.org directly.
EXTERNAL_MEDIA_ENABLED=true
EXTERNAL_MEDIA_TIMEOUT_MS=8000
EXTERNAL_MEDIA_CACHE_TTL_MS=600000
EXTERNAL_MEDIA_LIMIT=8